# ============================================================
# ArbitrageAI — Environment Configuration
# Copy to .env and fill in real values before starting
# ============================================================

# --- Database ---
POSTGRES_USER=arbitrage
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=arbitrageai
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://arbitrage:changeme_in_production@postgres:5432/arbitrageai

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- API Keys ---
# Keepa API key for Amazon product data (https://keepa.com/#!api)
KEEPA_API_KEY=your_keepa_api_key_here

# Claude/Anthropic API key for AI scoring narratives
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: OpenAI fallback
OPENAI_API_KEY=

# --- Amazon Affiliate / PA-API (optional for enhanced data) ---
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_ASSOCIATE_TAG=

# --- Notification Channels ---
# Telegram bot alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email alerts (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# --- Scraping ---
# Delay between requests in seconds (respect rate limits)
SCRAPER_REQUEST_DELAY_SECONDS=2
# Max concurrent scraper workers
SCRAPER_MAX_CONCURRENCY=3
# Proxy list (comma-separated, optional)
SCRAPER_PROXIES=

# --- Scoring Thresholds ---
# Minimum score to trigger alert
ALERT_SCORE_THRESHOLD=75
# Minimum ROI % to surface a deal
MIN_ROI_PERCENT=20

# --- Profitability Assumptions ---
# UK VAT rate (0.20 = 20%)
VAT_RATE=0.20
# FBA fulfilment fee per unit in GBP (used as fallback estimate)
FBA_FULFILMENT_ESTIMATE_GBP=3.50
# Estimated inbound shipping cost per kg in GBP
SHIPPING_COST_PER_KG_GBP=0.80
# Average product weight in kg (fallback)
DEFAULT_PRODUCT_WEIGHT_KG=0.5
# Amazon referral fee % (category default; per-category overrides in config)
AMAZON_REFERRAL_FEE_PERCENT=0.15

# --- App ---
SECRET_KEY=change_this_to_a_random_secret_key
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
